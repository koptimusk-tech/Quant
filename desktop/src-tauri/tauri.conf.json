{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quant Anomaly Lab",
  "version": "0.3.0",
  "identifier": "lab.quant-anomaly.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quant Anomaly Lab",
        "width": 1400,
        "height": 900,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../backend/qal": "backend/qal",
      "../../backend/migrations": "backend/migrations",
      "../../backend/alembic.ini": "backend/alembic.ini",
      "../../backend/pyproject.toml": "backend/pyproject.toml",
      "../../frontend/dist": "web"
    }
  }
}
