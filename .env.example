# Copy to backend/.env (or export the variables). All settings use the QAL_ prefix.

# Database. SQLite works out of the box; Docker Compose uses PostgreSQL.
QAL_DATABASE_URL=sqlite:///./var/qal.db
# QAL_DATABASE_URL=postgresql+psycopg://qal:qal@localhost:5432/qal

# Where immutable Parquet snapshots are written.
QAL_DATA_DIR=./var/data

# Background worker + scheduler inside the API process.
QAL_ENABLE_SCHEDULER=true
QAL_SCHEDULER_POLL_SECONDS=5
QAL_JOB_MAX_ATTEMPTS=3

# Crypto market data through CCXT. Public OHLCV needs no key.
QAL_CCXT_EXCHANGE=binance
# Keys are NOT used by research ingestion; reserved for a future, separately permissioned execution service.
QAL_CCXT_API_KEY=
QAL_CCXT_API_SECRET=

# Stooq may require an API key for CSV downloads depending on its current access rules.
QAL_STOOQ_API_KEY=

# MetaTrader 5 (Windows only, terminal must be installed). Leave empty to use the logged-in terminal.
QAL_MT5_TERMINAL_PATH=
QAL_MT5_LOGIN=
QAL_MT5_PASSWORD=
QAL_MT5_SERVER=

# Real order execution is not implemented. This flag exists so it can be asserted false.
QAL_LIVE_TRADING_ENABLED=false

QAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Serve the built frontend from the API (used by the desktop app; optional for web).
# QAL_FRONTEND_DIST=../frontend/dist

# Desktop app only (read by the Tauri launcher, not by the backend):
# QAL_PYTHON=python3            interpreter with the backend dependencies installed
# QAL_BACKEND_DIR=../backend    development override for the bundled backend
# QAL_DESKTOP_PORT=8765
